PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Meta WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-secret
META_APP_SECRET=
ALLOWED_USER_PHONE=33600000000

# Google Sheets
GOOGLE_SHEET_ID=
# Either a JSON string or base64-encoded service account JSON.
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS=

# Used when Google Sheets is not configured. Do not use in production.
USE_MEMORY_STORAGE=true
